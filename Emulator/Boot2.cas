;
;	Cobalt Boot ROM
;	0xF000 - 0xFFFF
;

; 105 Bytes v4
; 89  Bytes v4.2

format bin
origin 0x0000

nop								; Required for CPU boot

Main:
    ;mov r3, 0xFFFF
    ;mov word[0x0000:0x0000], ExceptionHandler
    ;sff 1

    mov     r0, 0x1234
    nop
    mov     r7, 0x4321
    add     r1, r0, r7
    add     r1, r1, 0x9876

    cmp     r1, 0xEDCB
    mov.z   r3, 0x3333
    jmp.eq  Wow
    mov     r5, 0x2222
    hlt

Wow:
    mov     r5, 0x1111
    nop

    mov     r7, 2

    cmp     r7, 3
    rcl.sf  r7, r7, 1
    jmp.ltu word[cg:r7+Tbl]
    jmp     Default
Tbl:dw  Case0, Case1, Case2
Case0:
    mov     r4, 0
    jmp     a
Case1:
    mov     r4, 1
    jmp     a
Case2:
    mov     r4, 2
    jmp     a
Default:
    mov     r4, 3
a:  hlt

ExceptionHandler:
    hlt
