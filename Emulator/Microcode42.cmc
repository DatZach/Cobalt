;
;	Cobalt ISAv4.2 Microcode
;

; TODO Normalize the operand indices per format

revision 4

;
;	Macros
;

# FETCH
	R IWORD CG:$IPO II IPCIW
END

# FETCH1
	R IWORD CG:$IPO II IPC1
END

# ILLEGAL
	#FETCH1
	TAI	3
	INTLATCH 1
	RTN
END

;
;	0 OPERANDS - TOOOCCCC XXXXXXXX
;

001 NOP
	#FETCH
	RTN
END

010 BRK
	#FETCH
	TAI 2
	INTLATCH 1
	RTN
END

100 RET
	#FETCH
	R WORD SG:$SPO JMP
	SPO ADD 2 SPI
	RTN
END

;; TODO RTI
;; TODO IRQx

111 HLT
	#FETCH
	HLT
	RTN
END

;
;   1 OPERANDS - TOOOCCCC OOSIIFFF
;

00000 JMPs REG
    #FETCH
    RSO1 JMP
    RTN
END

00000 JMPs IMM
    #FETCH
    ISO1 JMP
    RTN
END

00000 JMPs SZ[PG:REG+sIMM]
    #FETCH
    RSO1 SUB ISO1 TAI
    R SIZE PAG1:$TAO JMP
    RTN
END

00000 JMPs SZ[PG:REG]
    #FETCH
    R SIZE PAG1:$RSO1 JMP
    RTN
END

00000 JMPs SZ[PG:uIMM]
    #FETCH
    R SIZE PAG1:$ISO1 JMP
    RTN
END

;; TODO All of JMPl
00001 JMPl REG REG
    #FETCH
    RSO1 CGI
    RSO2 JMP
    RTN
END

00001 JMPl REG IMM
    #FETCH
    RSO1 CGI
    ISO2 JMP
    RTN
END

00001 JMPl REG SZ[PG:REG+sIMM]
    #FETCH
    RSO1 CGI
    RSO2 SUB ISO2 TAI
    R SIZE PAG2:$TAO JMP
    RTN
END

00001 JMPl REG SZ[PG:REG]
    #FETCH
    RSO1 CGI
    R SIZE PAG2:$RSO2 JMP
    RTN
END

00001 JMPl REG SZ[PG:uIMM]
    #FETCH
    RSO1 CGI
    R SIZE PAG2:$ISO2 JMP
    RTN
END

;; TODO 01000 SFF REG

01000 SFF IMM
    #FETCH
    FFI ISO1
    RTN
END

;; TODO 01000 SFF SZ[PG:REG+sIMM]
;; TODO 01000 SFF SZ[PG:REG]
;; TODO 01000 SFF SZ[PG:uIMM]

01100 CMP REG REG
    #FETCH
    RSO1 SUB RSO2 FI
    RTN
END

01100 CMP REG IMM
    #FETCH
    RSO1 SUB ISO2 FI
    RTN
END

01010 MOV REG REG
    #FETCH
    RSO2 RSI1
    RTN
END

01010 MOV REG IMM
    #FETCH
    ISO2 RSI1
    RTN
END

01010 MOV REG SZ[PG:REG+sIMM]
    #FETCH
    RSO2 SUB ISO2 TAI
    R SIZE PAG2:$TAO RSI1
    RTN
END

01010 MOV REG SZ[PG:REG]
    #FETCH
    R SIZE PAG2:$RSO2 RSI1
    RTN
END

01010 MOV REG SZ[PG:uIMM]
    #FETCH
    ISO2 TAI                                ; TODO Might be able to get rid of TCO and ISO2 on a-line?
    R SIZE PAG2:$TAO RSI1
    RTN
END

01010 MOV SZ[PG:REG+sIMM] REG
    #FETCH
    RSO1 SUB ISO1 TAI
    W SIZE PAG1:$TAO RSO2
    RTN
END

01010 MOV SZ[PG:REG+sIMM] IMM
    #FETCH
    RSO1 SUB ISO1 TAI
    W SIZE PAG1:$TAO ISO2
    RTN
END

01010 MOV SZ[PG:REG+sIMM] SZ[PG:REG+sIMM]
    #FETCH
    RSO2 SUB ISO2 TAI
    R SIZE PAG2:$TAO TBI
    RSO1 SUB ISO1 TAI
    W SIZE PAG1:$TAO TBO
    RTN
END

01010 MOV SZ[PG:REG+sIMM] SZ[PG:REG]
    #FETCH
    R SIZE PAG2:$RSO2 TBI
    RSO1 SUB ISO1 TAI
    W SIZE PAG1:$TAO TBO
    RTN
END

01010 MOV SZ[PG:REG+sIMM] SZ[PG:uIMM]
    #FETCH
    ISO2 TAI
    R SIZE PAG2:$TAO TBI
    RSO1 SUB ISO1 TAI
    W SIZE PAG1:$TAO TBO
    RTN
END

01010 MOV SZ[PG:REG] REG
    #FETCH
    W SIZE PAG1:$RSO1 RSO2
    RTN
END

01010 MOV SZ[PG:REG] IMM
    #FETCH
    W SIZE PAG1:$RSO1 ISO2
    RTN
END

01010 MOV SZ[PG:REG] SZ[PG:REG+sIMM]
    #FETCH
    RSO2 SUB ISO2 TAI
    R SIZE PAG2:$TAO TBI
    W SIZE PAG1:$RSO1 TBO
    RTN
END

01010 MOV SZ[PG:REG] SZ[PG:REG]
    #FETCH
    R SIZE PAG2:$RSO2 TBI
    W SIZE PAG1:$RSO1 TBO
    RTN
END

01010 MOV SZ[PG:REG] SZ[PG:uIMM]
    #FETCH
    ISO2 TAI
    R SIZE PAG2:$TAO TBI
    W SIZE PAG1:$RSO1 TBO
    RTN
END

01010 MOV SZ[PG:uIMM] REG
    #FETCH
    ISO1 TAI
    W SIZE PAG1:$TAO RSO1
    RTN
END

01010 MOV SZ[PG:uIMM] IMM
    #FETCH
    ISO1 TAI
    W SIZE PAG1:$TAO ISO2
    RTN
END

01010 MOV SZ[PG:uIMM] SZ[PG:REG+sIMM]
    #FETCH
    RSO2 SUB ISO2 TAI
    R SIZE PAG2:$TAO TBI
    ISO1 TAI
    W SIZE PAG1:$TAO TBO
    RTN
END

01010 MOV SZ[PG:uIMM] SZ[PG:REG]
    #FETCH
    ISO1 TAI
    R SIZE PAG2:$RSO2 TBI
    W SIZE PAG1:$TAO TBO
    RTN
END

01010 MOV SZ[PG:uIMM] SZ[PG:uIMM]
    #FETCH
    ISO2 TAI
    R SIZE PAG2:$TAO TBI
    ISO1 TAI
    W SIZE PAG1:$TAO TBO
    RTN
END

;
;	3 OPERANDS - TOOOCCCC OOSIIFFF
;

10000 ADD REG REG REG
    #FETCH
    RSO3 ADD RSO2 RSI1
    RTN
END

10000 ADD REG REG IMM
    #FETCH
    RSO2 ADD ISO3 RSI1
    RTN
END

10000 ADD SZ[PG:REG+sIMM] SZ[PG:REG+sIMM] SZ[PG:REG]
    #FETCH
    RSO2 SUB ISO2 TAI
    R SIZE PAG2:$TAO TBI
    R SIZE PAG3:$RSO3 TCI
    RSO1 SUB ISO1 TAI
    TBO ADD TCO TBI
    W SIZE PAG1:$TAO TBO
    RTN
END

10100 RCL REG REG IMM
    #FETCH
    RSO2 ROL ISO3 RSI1
    RTN
END