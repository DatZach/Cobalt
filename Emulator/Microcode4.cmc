;
;	Cobalt ISAv4 Microcode
;

revision 4

;
;	Macros
;

# FETCH1
	R DWORD CG:$IPO II IPC1
END

# FETCH2
	R DWORD CG:$IPO II IPC2
END

# FETCH3
	R DWORD CG:$IPO II IPC3
END

# FETCH4
	R DWORD CG:$IPO II IPC4
END

# ILLEGAL                           ; TODO Optimize
	#FETCH1
	TAI	1 2 IPC2
	INTLATCH 1
	RTN
END

;
;	0 OPERANDS - TOOOFFFF XXXXXXXX
;

0 001 NOP
	#FETCH1
	RTN
END

0 111 HLT
	#FETCH1
	HLT
	RTN
END

;
;	1 OPERANDS - TTOOOOAA ABBBXXXX
;

; 1OOOOOFF FFAAAXXX RRRRXXXX
; 1OOOOOFF FFAAARRR
1 00000 JMPs REG
    #FETCH3
    IPO ADD RSO1 JMP
    RTN
END

; 1OOOOOFF FFAAAXXX IIIIIIII IIIIIIII
; 1OOOOOFF FFAAAXXX IIIIIIII
1 00000 JMPs IMM
    #FETCH2
    R IMMW CG:$IPO JMP
    RTN
END

; 1OOOOOFF FFAAAXXX RRRRXXXX IIIIIIII IIIIIIII
; 1OOOOOFF FFAAAXXX RRRRXXXX IIIIIIII
1 00000 JMPs SZ[PG:REG+sIMM]
	#FETCH3
	R IMMW CG:$IPO TBI IPCIMMW
	RSO1 SUB TBO TAI
	R SIZ1 PAG1:$TAO JMP
	RTN
END

; 1OOOOOFF FFAAAXXX RRRRXXXX
; 1OOOOOFF FFAAAXXX RRRRXXXX
1 00000 JMPs SZ[PG:REG]
	#FETCH3
	R SIZ1 PAG1:$RSO1 JMP
	RTN
END

; 1OOOOOFF FFAAAXXX RRRRXXXX IIIIIIII IIIIIIII
; 1OOOOOFF FFAAAXXX RRRRXXXX IIIIIIII
1 00000 JMPs SZ[PG:uIMM]
	#FETCH3
	R IMMW CG:$IPO TAI IPCIMMW
	R SIZ1 PAG1:$TAO JMP
	RTN
END

; 1OOOOOFF FFAAABBB RRRRRRRR
2 00001 JMPl REG REG
    #FETCH3
	RSO1 CGI
    RSO2 JMP
    RTN
END

; 1OOOOOFF FFAAABBB RRRRXXXX IIIIIIII IIIIIIII
2 00001 JMPl REG IMM
    #FETCH3
	RSO1 CGI
    R IMMW CG:$IPO JMP
    RTN
END

; 1OOOOOFF FFAAABBB RRRRRRRR IIIIIIII [IIIIIIII]
2 00001 JMPl REG SZ[PG:REG+sIMM]
	#FETCH3
	RSO1 CGI
	R IMMW CG:$IPO TBI IPCIMMW
	RSO2 SUB TBO TBI
	R SIZ1 PAG1:$TBO JMP
	RTN
END

; 1OOOOOFF FFAAABBB RRRRRRRR
2 00001 JMPl REG SZ[PG:REG]
	#FETCH3
	RSO1 CGI
	R SIZ2 PAG2:$RSO2 JMP
	RTN
END

; 1OOOOOFF FFAAABBB RRRRRRRR IIIIIIII [IIIIIIII]
2 00001 JMPl REG SZ[PG:uIMM]
	#FETCH3
	RSO1 CGI
	R IMMW CG:$IPO TAI IPCIMMW
	R SIZ2 PAG2:$TAO JMP
	RTN
END

;
;	2 OPERANDS - TOOOOOFF FFAAABBB
;

; 1OOOOOFF FFAAABBB RRRRRRRR
2 01100 CMP REG REG
    #FETCH3
	RSO1 SUB RSO2 FI
	RTN
END

; TODO CMP REG IMM8 - FETCH4 Cycle optimization
; TODO CMP REG IMM16 - FETCH3 R SIZ2 Macro?

; 1OOOOOFF FFAAABBB RRRRXXXX IIIIIIII IIIIIIII
; 1OOOOOFF FFAAABBB RRRRXXXX IIIIIIII
2 01100 CMP REG IMM
    #FETCH3
	R IMMW CG:$IPO TBI IPCIMMW
	RSO1 SUB TBO FI
	RTN
END

; 1OOOOOFF FFAAABBB RRRRRRRR
2 01010 MOV REG REG
	#FETCH3
	RSO2 RSI1
	RTN
END

; 1OOOOOFF FFAAABBB RRRRXXXX IIIIIIII IIIIIIII
; 1OOOOOFF FFAAABBB RRRRXXXX IIIIIIII
2 01010 MOV REG IMM
	#FETCH3
	R IMMW CG:$IPO RSI1 IPCIMMW
	RTN
END

;; TODO 2 01010 MOV REG SZ[PG:REG+sIMM]
;; TODO 2 01010 MOV REG SZ[PG:REG]
;; TODO 2 01010 MOV REG [PG:uIMM16]
;; TODO 2 01010 MOV SZ[PG:REG+sIMM] REG
;; TODO 2 01010 MOV SZ[PG:REG+sIMM] IMM
;; TODO 2 01010 MOV SZ[PG:REG+sIMM] SZ[PG:REG+sIMM]
;; TODO 2 01010 MOV SZ[PG:REG+sIMM] SZ[PG:REG]
;; TODO 2 01010 MOV SZ[PG:REG+sIMM] [PG:uIMM16]
;; TODO 2 01010 MOV SZ[PG:REG] REG
;; TODO 2 01010 MOV SZ[PG:REG] IMM
;; TODO 2 01010 MOV SZ[PG:REG] SZ[PG:REG+sIMM]
;; TODO 2 01010 MOV SZ[PG:REG] SZ[PG:REG]
;; TODO 2 01010 MOV SZ[PG:REG] [PG:uIMM16]
;; TODO 2 01010 MOV [PG:uIMM16] REG
;; TODO 2 01010 MOV [PG:uIMM16] IMM
;; TODO 2 01010 MOV [PG:uIMM16] SZ[PG:REG+sIMM]
;; TODO 2 01010 MOV [PG:uIMM16] SZ[PG:REG]
;; TODO 2 01010 MOV [PG:uIMM16] [PG:uIMM16]

;
;	3 OPERANDS - TOOOOOFF FFAAABBB
;

; 1OOOOOFF FFAAABBB RRRRRRRR RRRRXXXX
; 1OOOOOFF FFAAABBB RRRRRRRR
3 10000 ADD REG REG REG
	R DWORD CG:$IPO II IPC4			; #FETCH4, f32 -> FETCH3
	RSO3 ADD RSO2 RSI1 FI
	RTN
END

; 1OOOOOFF FFAAABBB RRRRRRRR IIIIIIII [IIIIIIII]
; 1OOOOOFF FFAAABBB RRRRXXXX IIIIIIII [IIIIIIII]
3 10000 ADD REG REG IMM
	#FETCH3							; #FETCH3, f32 -> FETCH3, fIMM8 -> FETCH3
	R IMMW CG:$IPO TBI IPCIMMW
	TBO ADD RSO2 RSI1 FI
	RTN
END

; 1OOOOOFF FFAAABBB RRRRRRRR IIIIIIII [IIIIIIII]
3 10100 RCL REG REG IMM
	#FETCH3
	R IMMW CG:$IPO TBI IPCIMMW
	RSO2 ROL TBO RSI1 FI
	RTN
END