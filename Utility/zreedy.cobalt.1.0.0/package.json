{
	"name": "cobalt",
	"displayName": "Cobalt Tools",
	"description": "Cobalt",
	"version": "1.0.0",
	"categories": [ "Programming Languages" ],
	"authors": {
		"name": "Zach Reedy"
	},
	"publisher": "zreedy",
	"repository": {
		"url": "https://github.com/DatZach/Cobalt",
		"type": "git"
	},
	"engines": {
		"vscode": "^1.105.0"
	},
	"main": "./out/extension.js",
	"workspaceTrust": {
		"request": "never"
	},
	"contributes": {
		"languages": [{
			"id": "cmc",
			"aliases": [ "CMC", "Cobalt Machine Code" ],
			"extensions": [ ".cmc" ],
			"configuration": "./cmc-language-configuration.json",
			"icon":{
				"dark": "./Icon.png",
				"light": "./Icon.png"
			}
		}, {
			"id": "cob",
			"aliases": [ "Cobalt" ],
			"extensions": [ ".cob" ],
			"configuration": "./cob-language-configuration.json",
			"icon":{
				"dark": "./Icon.png",
				"light": "./Icon.png"
			}
		}],
		"grammars": [{
			"language": "cmc",
			"scopeName": "source.cmc",
			"path": "./syntaxes/cmc.tmLanguage"
		}, {
			"language": "cob",
			"scopeName": "source.cob",
			"path": "./syntaxes/cobalt.tmLanguage"
		}],
		"commands": [{
			"command": "extension.cobalt-debug.debugEditorContents",
			"title": "Debug",
			"category": "Cobalt Debug",
			"enablement": "!inDebugMode",
			"icon": "$(debug-alt)"
		}, {
			"command": "extension.cobalt-debug.runEditorContents",
			"title": "Execute",
			"category": "Cobalt Debug",
			"enablement": "!inDebugMode",
			"icon": "$(play)"
		}],
		"menus": {
			"editor/title/run": [{
				"command": "extension.cobalt-debug.runEditorContents",
				"when": "resourceLangId == cob",
				"group": "navigation@1"
			}, {
				"command": "extension.cobalt-debug.debugEditorContents",
				"when": "resourceLangId == cob",
				"group": "navigation@2"
			}],
			"commandPalette": [{
				"command": "extension.cobalt-debug.debugEditorContents",
				"when": "resourceLangId == cob"
			}, {
				"command": "extension.cobalt-debug.runEditorContents",
				"when": "resourceLangId == cob"
			}]
		},
		"keybindings":[{
			"command": "extension.cobalt-debug.debugEditorContents",
			"key": "f5"
		}, {
			"command": "extension.cobalt-debug.runEditorContents",
			"key": "shift+f5"
		}],
		"breakpoints": [{
			"language": "cob"
		}],
		"debuggers": [{
			"type": "cobalt",
			"languages": [ "cob" ],
			"label": "Cobalt Debugger",
			"initialConfigurations": [
				{
					"type": "cobalt",
					"request": "launch",
					"name": "Ask for file name",
					"entryCobPath": "${file}",
					"commandLine": []
				}
			]
		}],
		"configuration": [{
			"title": "Cobalt",
			"properties": {
				"cobalt.toolchainDirectory": {
					"type": "string",
					"default": "X:\\Cobalt\\Compiler\\bin\\Debug\\net6.0",
					"description": "Directory where the Cobalt Toolchain exists"
				}
			}
		}]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint src",
		"test": "vscode-test"
	},
	"dependencies": {
		"glob": "^11.0.0",
		"vscode-languageclient": "^9.0.1"
	},
	"devDependencies": {
		"@types/vscode": "^1.146.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "22.x",
		"@vscode/debugadapter": "^1.56.0",
    	"@vscode/debugadapter-testsupport": "^1.56.0",
		"typescript-eslint": "^8.52.0",
		"eslint": "^9.39.2",
		"typescript": "^5.9.3",
		"@vscode/test-cli": "^0.0.12",
		"@vscode/test-electron": "^2.5.2"
	}
}